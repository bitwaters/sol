# === GMGN ===
GMGN_API_KEY=
# M1 起可选（follow-wallet 签名需要；无私钥该源禁用）
GMGN_PRIVATE_KEY=
# 可选逃生通道
# GMGN_PROXY=http://127.0.0.1:7890

# === Telegram（M3 前可留空）===
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_ADMIN_IDS=
TG_ALERT_CHAT_ID=

# === 运行模式 ===
DRY_RUN=0
# 关闭上游 client 的 429 自动重试，由本项目限流器统一处理
GMGN_RATE_LIMIT_AUTO_RETRY_MAX_WAIT_MS=0
# 限流速率（权重/秒）：个人 Key 20；demo key 为 IP 级严格限频，建议 1
GMGN_RATE_LIMIT_PER_SEC=20
